VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️  NEVER put a real secret behind a VITE_ prefix.
#    Vite inlines every VITE_* value into the shipped JavaScript, so it becomes
#    public. That is fine for the Supabase URL and the ANON key (both are
#    designed to be public and are protected by Row Level Security) — but a
#    service-role key, JWT secret, or DB password must NEVER be VITE_-prefixed.
#    The build fails on purpose if it sees one (see vite.config.js).
#    Server-only secrets belong in the Supabase dashboard / server env, not here.

# Optional — canonical public site URL. Set this to your deployed site
# (e.g. https://your-site.example.com) so paddle QR codes always encode the
# live scan URL, even when they are generated while testing on localhost.
# VITE_SITE_URL=